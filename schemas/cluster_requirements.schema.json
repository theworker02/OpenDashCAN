{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendashcan.local/schemas/cluster_requirements.schema.json",
  "title": "OpenDashCAN Cluster Requirements",
  "type": "object",
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signal": { "type": ["string", "null"] },
          "name": { "type": "string" },
          "message": { "type": ["string", "null"] },
          "arbitration_id": { "type": ["string", "integer", "null"] },
          "priority": {
            "type": "string",
            "enum": ["REQUIRED", "OPTIONAL", "COSMETIC", "UNKNOWN"]
          },
          "confidence": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
